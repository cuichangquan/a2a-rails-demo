#!/usr/bin/env ruby
# frozen_string_literal: true
require "bundler"
require "digest"
require "a2a-rails"

# Historical 0.4.0 baseline verifier. Current candidate: bin/verify_candidate.
# SHA-256 of the exact a2a-rails 0.4.0 package published to RubyGems.
RELEASE_SHA256 = "77b36d4c1cc0db5ab028a35556f1495596f930a25922ff2bf29cde761d45132a"
spec = Gem.loaded_specs.fetch("a2a-rails")
resolved = Bundler.load.specs.find { |candidate| candidate.name == "a2a-rails" }
abort "Wrong a2a-rails version" unless spec.version.to_s == "0.4.0" && A2A::Rails::VERSION == "0.4.0"
abort "a2a-rails must come from RubyGems" unless resolved&.source.is_a?(Bundler::Source::Rubygems)
abort "Published Gem package is missing from the install cache" unless File.file?(spec.cache_file)
abort "Published Gem package checksum mismatch" unless Digest::SHA256.file(spec.cache_file).hexdigest == RELEASE_SHA256
puts "PASS: published RubyGems a2a-rails 0.4.0, SHA-256 #{RELEASE_SHA256}"

json_spec = Bundler.load.specs.find { |candidate| candidate.name == "json" }
imap_spec = Bundler.load.specs.find { |candidate| candidate.name == "net-imap" }
abort "Unpatched json" unless json_spec && Gem::Requirement.new(">= 2.19.9", "< 3").satisfied_by?(json_spec.version)
abort "Unpatched net-imap" unless imap_spec && Gem::Requirement.new("~> 0.5.15").satisfied_by?(imap_spec.version)
puts "PASS: json #{json_spec.version}, net-imap #{imap_spec.version}"
