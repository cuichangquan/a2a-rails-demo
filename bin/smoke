#!/usr/bin/env ruby
# frozen_string_literal: true
# Real HTTP verification; target must be local (never probe public endpoints).
require "json"
require "net/http"
require "securerandom"
require "uri"
abort "Usage: bin/smoke [--report|--continuation]" unless ARGV.empty? || ARGV == ["--report"] || ARGV == ["--continuation"]

BASE = URI(ENV.fetch("DEMO_URL", "http://127.0.0.1:3000"))
unless BASE.scheme == "http" && %w[127.0.0.1 localhost].include?(BASE.host)
  abort "Smoke runs only against HTTP localhost / 127.0.0.1"
end

def assert(value, what)
  raise "FAIL: #{what}" unless value
  puts "PASS: #{what}"
end

def request(path, payload: nil, headers: {})
  uri = URI.join(BASE.to_s + "/", path.delete_prefix("/"))
  req = payload ? Net::HTTP::Post.new(uri) : Net::HTTP::Get.new(uri)
  req["A2A-Version"] = headers.fetch("A2A-Version", "1.0")
  if payload
    req["Content-Type"] = "application/json"
    req.body = JSON.generate(payload)
  end
  response = Net::HTTP.start(uri.hostname, uri.port, open_timeout: 5, read_timeout: 15) { |http| http.request(req) }
  [response.code.to_i, JSON.parse(response.body)]
end

def rpc(method, params, version: "1.0")
  request("/a2a", payload: {
    "jsonrpc" => "2.0",
    "id" => SecureRandom.uuid,
    "method" => method,
    "params" => params
  }, headers: { "A2A-Version" => version })
end

def send_message(text, context_id: nil)
  msg = { "messageId" => SecureRandom.uuid, "role" => "ROLE_USER", "parts" => [{ "text" => text }] }
  msg["contextId"] = context_id if context_id
  rpc("SendMessage", { "message" => msg })
end

code, card = request("/.well-known/agent-card.json")
assert(code == 200 && card["name"] == "Echo Agent", "Agent Card discovery")
assert(card.fetch("supportedInterfaces").any? { |i|
  i["protocolBinding"] == "JSONRPC" && i["protocolVersion"] == "1.0" && i["url"].end_with?("/a2a")
}, "A2A Protocol 1.0 JSONRPC endpoint advertised")
assert(card.fetch("skills").any? { |s| s["id"] == "reply" }, "Echo Skill advertised")
assert(card.fetch("skills").map { |skill| skill.fetch("id") }.sort == %w[reply report], "Agent Card includes Echo and report")

code, task_reply = send_message("Hello from Rails")
assert(code == 200 && task_reply.dig("result", "task"), "SendMessage default Task")
task = task_reply.fetch("result").fetch("task")
assert(task.dig("status", "state") == "TASK_STATE_COMPLETED", "Task completed")
assert(task.fetch("artifacts").first.fetch("parts").first.fetch("text") == "Echo: Hello from Rails", "Task text Artifact")

code, got = rpc("GetTask", { "id" => task.fetch("id") })
assert(code == 200 && got.dig("result", "id") == task.fetch("id"), "GetTask")
code, listed = rpc("ListTasks", { "contextId" => task.fetch("contextId"), "includeArtifacts" => true })
assert(code == 200 && listed.dig("result", "totalSize") == 1, "ListTasks has one Task")
assert(listed.dig("result", "tasks", 0, "id") == task.fetch("id"), "ListTasks scoped to context")

code, direct_reply = send_message("direct: Hello", context_id: task.fetch("contextId"))
assert(code == 200 && direct_reply.dig("result", "message"), "SendMessage direct Message")
msg = direct_reply.fetch("result").fetch("message")
assert(msg["role"] == "ROLE_AGENT" && !msg["messageId"].to_s.empty?, "Direct Message identity")
assert(msg.fetch("parts").first.fetch("text") == "Echo: direct: Hello", "Direct Message text")
assert(!direct_reply.fetch("result").key?("task"), "Direct response has no Task")
_, after = rpc("ListTasks", { "contextId" => task.fetch("contextId") })
assert(after.dig("result", "totalSize") == 1, "Direct Message did not persist Task")

_, cancellation = rpc("CancelTask", { "id" => task.fetch("id") })
assert(cancellation.dig("error", "code") == -32002, "Terminal Task cannot be canceled (-32002)")
_, version = rpc("ListTasks", {}, version: "0.3")
assert(version.dig("error", "code") == -32009, "Unsupported A2A protocol version rejected (-32009)")
if ARGV.empty?
  puts "Standalone a2a-rails-demo Echo HTTP smoke: PASS"
  exit
end
# Existing one-shot report flow. No metadata workaround: conditions are a Data Part.
def send_report(criteria)
  rpc("SendMessage", { "message" => { "messageId" => SecureRandom.uuid,
    "role" => "ROLE_USER", "parts" => [{ "data" => criteria }] } })
end

report_skill = card.fetch("skills").find { |skill| skill["id"] == "report" }
assert(report_skill && report_skill["inputModes"] == ["application/json"], "Report Skill declares Data input")
conditions = { "year" => 2026, "month" => 10, "department_id" => 123 }
expected_report = conditions.merge("sales_count" => 3, "total_amount" => 35_000, "currency" => "JPY")
code, report_reply = send_report(conditions)
report = report_reply.dig("result", "task")
assert(code == 200 && report && report.dig("status", "state") == "TASK_STATE_COMPLETED", "Report Task completed")
assert(report.dig("artifacts", 0, "parts", 0, "data") == expected_report, "Report business result matches fixed sales")
_, fetched_report = rpc("GetTask", { "id" => report.fetch("id"), "historyLength" => 1 })
assert(fetched_report.dig("result", "artifacts", 0, "parts", 0, "data") == expected_report, "GetTask preserves report Data Artifact")
assert(fetched_report.dig("result", "history", 0, "parts", 0, "data") == conditions, "GetTask preserves report conditions")
_, invalid_report = send_report(conditions.merge("month" => 13))
rejected = invalid_report.dig("result", "task")
assert(rejected && rejected.dig("status", "state") == "TASK_STATE_REJECTED", "Invalid report month is a rejected Task")
assert(Array(rejected["artifacts"]).empty?, "Invalid conditions produce no report Artifact")
puts "Standalone a2a-rails-demo Echo and report HTTP smoke: PASS"
exit unless ARGV == ["--continuation"]

def answer_report(task_id, criteria)
  rpc("SendMessage", { "message" => { "messageId" => SecureRandom.uuid,
    "taskId" => task_id, "role" => "ROLE_USER", "parts" => [{ "data" => criteria }] } })
end

_, waiting_reply = send_report({ "year" => 2026, "month" => 10 })
waiting = waiting_reply.dig("result", "task")
assert(waiting && waiting.dig("status", "state") == "TASK_STATE_INPUT_REQUIRED", "Missing department asks for input")
id = waiting.fetch("id")
context_id = waiting.fetch("contextId")
assert(waiting.dig("status", "message", "parts").any? { |part| part["text"] == "Please provide: department_id." }, "Question is a Task status message")
_, got_waiting = rpc("GetTask", { "id" => id, "historyLength" => 0 })
assert(got_waiting.dig("result", "status", "state") == "TASK_STATE_INPUT_REQUIRED", "Waiting Task can be fetched without response history")
_, waiting_list = rpc("ListTasks", { "contextId" => context_id })
assert(waiting_list.dig("result", "tasks").any? { |entry| entry["id"] == id && entry.dig("status", "state") == "TASK_STATE_INPUT_REQUIRED" }, "Waiting Task can be listed")
_, completed_reply = answer_report(id, { "department_id" => 123 })
completed = completed_reply.dig("result", "task")
assert(completed && completed["id"] == id && completed["contextId"] == context_id, "Answer preserves Task and context")
assert(completed.dig("status", "state") == "TASK_STATE_COMPLETED" && completed.dig("artifacts", 0, "parts", 0, "data") == expected_report, "Same Task returns combined criteria and exact aggregate")
_, terminal = answer_report(id, { "department_id" => 123 })
assert(terminal.dig("error", "code") == -32004 && !terminal["result"], "New answer to completed Task is rejected")

_, repeat_reply = send_report({ "year" => 2026 })
repeat_id = repeat_reply.dig("result", "task", "id")
_, repeated = answer_report(repeat_id, { "month" => 10 })
assert(repeated.dig("result", "task", "id") == repeat_id && repeated.dig("result", "task", "status", "state") == "TASK_STATE_INPUT_REQUIRED", "Incomplete answer asks again on same Task")
_, repeat_complete = answer_report(repeat_id, { "department_id" => 123 })
assert(repeat_complete.dig("result", "task", "id") == repeat_id && repeat_complete.dig("result", "task", "artifacts", 0, "parts", 0, "data") == expected_report, "Two answers complete original Task")

_, cancel_reply = send_report({ "year" => 2026, "month" => 10 })
cancel_id = cancel_reply.dig("result", "task", "id")
_, canceled = rpc("CancelTask", { "id" => cancel_id })
assert(canceled.dig("result", "status", "state") == "TASK_STATE_CANCELED", "Input-required Task can be canceled")
_, late_answer = answer_report(cancel_id, { "department_id" => 123 })
assert(late_answer.dig("error", "code") == -32004 && !late_answer["result"], "Late answer does not revive canceled Task")
puts "Standalone a2a-rails-demo continuation HTTP smoke: PASS"
